# Copy this file to .env and fill in real values. Never commit .env.
# This file is safe to commit — every value below is a placeholder, not a
# real credential. See docs/SECURITY_PRIVACY.md.

# --- LLM providers ---
# Model names are never assumed by the app - if you select a provider below,
# you must also set its *_MODEL env var.
NEBIUS_API_KEY=
NEBIUS_MODEL=
FIREWORKS_API_KEY=
FIREWORKS_MODEL=

# Which provider to use by default, and which to fall back to if the
# primary fails after retries. One of: nebius, fireworks, mock.
DEFAULT_LLM_PROVIDER=mock
FALLBACK_LLM_PROVIDER=

# Retry policy for transient LLM provider failures (timeouts, rate limits,
# provider-unavailable). Bounded - never retries indefinitely.
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30

# --- Vector store (evidence retrieval only - see docs/DECISIONS.md #3) ---
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=hireloop-evidence

# --- Long-term memory ---
MEM0_API_KEY=

# --- Local structured storage ---
SQLITE_DB_PATH=data/hireloop.db

# Demo mode: lets the app run end-to-end without real LLM API keys (falls
# back to the deterministic mock provider) and seeds historical application
# data for the Learning Agent.
DEMO_MODE=true

# --- You.com live job discovery (OPTIONAL, opt-in, read-only) ---
# Live job discovery is never used by DEMO_MODE and never a dependency of
# the certification demo path. It only discovers job pages (title/source/
# url/snippet) -- it never scores, ranks, tailors, or applies. Leave
# YOU_SEARCH_ENABLED=false (the default) unless you intend to spend real
# You.com API credit from the Opportunities page's "LIVE SEARCH" mode.
YDC_API_KEY=
YOU_SEARCH_ENABLED=false
YOU_SEARCH_TIMEOUT_SECONDS=15
YOU_SEARCH_MAX_RESULTS=10
YOU_SEARCH_EXTRACTION_MODE=highlights
YOU_SEARCH_MAX_QUERIES_PER_RUN=4
